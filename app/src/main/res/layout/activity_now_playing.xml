<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    tools:background="#FF17171A"
    tools:ignore="MergeRootFrame">

    <!-- the drift layer only moves and the stage only fades, so their animations never fight -->
    <FrameLayout
        android:id="@+id/drift"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            tools:ignore="UselessParent">

            <!-- player: cover on the left, a column as tall as the cover on the right with the text at
                 the top and the controls at the bottom, so a title on two lines never moves them -->
            <LinearLayout
                android:id="@+id/player"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="72dp"
                android:paddingTop="40dp"
                android:paddingEnd="72dp"
                android:paddingBottom="40dp">

                <FrameLayout
                    android:id="@+id/cover"
                    android:layout_width="@dimen/cover_size"
                    android:layout_height="@dimen/cover_size"
                    android:background="@drawable/cover_background"
                    android:elevation="28dp">

                    <!-- seen while there is no cover -->
                    <ImageView
                        android:layout_width="132dp"
                        android:layout_height="132dp"
                        android:layout_gravity="center"
                        android:alpha="0.22"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_music_note" />

                    <ImageView
                        android:id="@+id/coverA"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/coverB"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/cover_size"
                    android:layout_marginStart="60dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/title"
                            style="@style/NowPlaying.Text"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textSize="36sp" />

                        <TextView
                            android:id="@+id/artist"
                            style="@style/NowPlaying.Text"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/text_artist"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/album"
                            style="@style/NowPlaying.Text"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="19sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/elapsed"
                                style="@style/NowPlaying.Time"
                                android:layout_width="54dp"
                                android:gravity="start|center_vertical" />

                            <io.github.besliky.airplaytv.ui.PillBar
                                android:id="@+id/progress"
                                android:layout_width="0dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/remaining"
                                style="@style/NowPlaying.Time"
                                android:layout_width="62dp"
                                android:gravity="end|center_vertical" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/previous"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:contentDescription="@null"
                                android:padding="11dp"
                                android:src="@drawable/ic_previous" />

                            <FrameLayout
                                android:id="@+id/playPause"
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_marginStart="26dp"
                                android:layout_marginEnd="26dp">

                                <ImageView
                                    android:id="@+id/pauseIcon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@null"
                                    android:padding="22dp"
                                    android:src="@drawable/ic_pause" />

                                <ImageView
                                    android:id="@+id/playIcon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:alpha="0"
                                    android:contentDescription="@null"
                                    android:padding="22dp"
                                    android:src="@drawable/ic_play" />
                            </FrameLayout>

                            <ImageView
                                android:id="@+id/next"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:contentDescription="@null"
                                android:padding="11dp"
                                android:src="@drawable/ic_next" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/volumeLow"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_volume_low"
                                android:tint="@color/text_secondary" />

                            <io.github.besliky.airplaytv.ui.PillBar
                                android:id="@+id/volume"
                                android:layout_width="0dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="14dp"
                                android:layout_marginEnd="14dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:id="@+id/volumeHigh"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_volume_high"
                                android:tint="@color/text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/hint"
                            style="@style/NowPlaying.Text"
                            android:layout_marginTop="14dp"
                            android:alpha="0"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- lyrics, opened with Down -->
            <FrameLayout
                android:id="@+id/lyricsPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginStart="72dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="72dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/lyricsCover"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/cover_small_background"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lyricsTitle"
                            style="@style/NowPlaying.Text"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/lyricsArtist"
                            style="@style/NowPlaying.Text"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="17sp" />
                    </LinearLayout>
                </LinearLayout>

                <io.github.besliky.airplaytv.ui.LyricsView
                    android:id="@+id/lyrics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="72dp"
                    android:layout_marginTop="140dp"
                    android:layout_marginEnd="72dp"
                    android:layout_marginBottom="96dp" />

                <TextView
                    android:id="@+id/lyricsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="72dp"
                    android:layout_marginEnd="72dp"
                    android:layout_marginBottom="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lyricsElapsed"
                        style="@style/NowPlaying.Time"
                        android:layout_width="54dp"
                        android:gravity="start|center_vertical" />

                    <io.github.besliky.airplaytv.ui.PillBar
                        android:id="@+id/lyricsProgress"
                        android:layout_width="0dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/lyricsRemaining"
                        style="@style/NowPlaying.Time"
                        android:layout_width="62dp"
                        android:gravity="end|center_vertical" />
                </LinearLayout>

                <!-- the volume bar appears here for a moment when the volume changes -->
                <LinearLayout
                    android:id="@+id/lyricsVolume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="100dp"
                    android:alpha="0"
                    android:background="@drawable/volume_popup_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_volume_low"
                        android:tint="@color/text_secondary" />

                    <io.github.besliky.airplaytv.ui.PillBar
                        android:id="@+id/lyricsVolumeBar"
                        android:layout_width="240dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_volume_high"
                        android:tint="@color/text_secondary" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- a small card that wanders over black while nobody is watching -->
    <LinearLayout
        android:id="@+id/ambient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ambientCover"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/cover_small_background"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ambientTitle"
                style="@style/NowPlaying.Text"
                android:layout_width="260dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/ambientArtist"
                style="@style/NowPlaying.Text"
                android:layout_width="260dp"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/goodnight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:fontFamily="sans-serif"
        android:textColor="@color/text_secondary"
        android:textSize="22sp"
        android:visibility="gone" />
</FrameLayout>
