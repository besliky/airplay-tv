<?xml version="1.0" encoding="utf-8"?>
<!--
    The car app's one window: a dock along the driver's side and the open page next to it.
    Pages: home (clock, what is playing, connection), music (Now Playing with touch controls),
    mirror (the phone's picture, with a side panel when the picture is portrait) and setup.
    All pages live in this one window on purpose, so switching never re-creates the video surface's
    window; hence the depth and number of views.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame,NestedWeights,TooDeepLayout,TooManyViews">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- dock -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="@dimen/car_dock_width"
            android:layout_height="match_parent"
            android:background="@color/car_dock"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextClock
                android:id="@+id/dockClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:format12Hour="h:mm"
                android:format24Hour="H:mm"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <ImageView
                android:id="@+id/dockSignal"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/car_network"
                android:src="@drawable/ic_car_wifi" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/dockHome"
                style="@style/Car.DockButton"
                android:contentDescription="@string/car_home"
                android:src="@drawable/ic_car_home" />

            <ImageButton
                android:id="@+id/dockMirror"
                style="@style/Car.DockButton"
                android:contentDescription="@string/car_phone_screen"
                android:src="@drawable/ic_car_phone" />

            <FrameLayout
                android:id="@+id/dockMusic"
                style="@style/Car.DockButton"
                android:clickable="true"
                android:contentDescription="@string/car_now_playing"
                android:focusable="true"
                android:padding="0dp">

                <ImageView
                    android:id="@+id/dockMusicIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_music_note"
                    android:tint="@color/text_primary" />

                <ImageView
                    android:id="@+id/dockCover"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/cover_small_background"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/dockSettings"
                style="@style/Car.DockButton"
                android:contentDescription="@string/car_settings"
                android:src="@drawable/ic_car_settings" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- ============ home ============ -->
            <LinearLayout
                android:id="@+id/pageHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/car_page_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextClock
                        android:id="@+id/homeClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:fontFeatureSettings="tnum"
                        android:format12Hour="h:mm"
                        android:format24Hour="H:mm"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/car_home_clock" />

                    <TextClock
                        android:id="@+id/homeDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:format12Hour="EEEE, d MMMM"
                        android:format24Hour="EEEE, d MMMM"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/car_page_padding"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- what is playing -->
                    <FrameLayout
                        android:id="@+id/homeMusicCard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.15"
                        android:background="@drawable/car_card"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:id="@+id/homeTrack"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/homeCover"
                                    android:layout_width="@dimen/car_home_cover"
                                    android:layout_height="@dimen/car_home_cover"
                                    android:background="@drawable/cover_background"
                                    android:contentDescription="@null"
                                    android:scaleType="centerCrop" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="20dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/homeTitle"
                                        style="@style/Car.Title"
                                        android:maxLines="2"
                                        android:textSize="24sp" />

                                    <TextView
                                        android:id="@+id/homeArtist"
                                        style="@style/Car.Subtitle"
                                        android:layout_marginTop="6dp"
                                        android:textSize="19sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/homeProgress"
                                style="@style/Car.Progress"
                                android:layout_marginTop="12dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/homePrevious"
                                    style="@style/Car.TransportButton"
                                    android:contentDescription="@string/car_previous"
                                    android:src="@drawable/ic_previous" />

                                <ImageButton
                                    android:id="@+id/homePlay"
                                    style="@style/Car.TransportButton"
                                    android:layout_marginStart="28dp"
                                    android:layout_marginEnd="28dp"
                                    android:contentDescription="@string/car_play_pause"
                                    android:src="@drawable/ic_pause" />

                                <ImageButton
                                    android:id="@+id/homeNext"
                                    style="@style/Car.TransportButton"
                                    android:contentDescription="@string/car_next"
                                    android:src="@drawable/ic_next" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/homeNoTrack"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="24dp">

                            <ImageView
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:alpha="0.5"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_music_note" />

                            <TextView
                                style="@style/Car.Title"
                                android:layout_width="wrap_content"
                                android:layout_marginTop="16dp"
                                android:gravity="center"
                                android:text="@string/car_nothing_playing"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/homeNoTrackHint"
                                style="@style/Car.Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:maxLines="3"
                                android:textSize="17sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- the phone and the network -->
                    <LinearLayout
                        android:id="@+id/homeConnectionCard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/car_page_padding"
                        android:layout_weight="1"
                        android:background="@drawable/car_card"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/homeStatusDot"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/status_dot" />

                            <TextView
                                android:id="@+id/homeStatus"
                                style="@style/Car.Title"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:textSize="22sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/homeStatusDetail"
                            style="@style/Car.Subtitle"
                            android:layout_marginTop="10dp"
                            android:maxLines="4"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/homeNetwork"
                            style="@style/Car.Subtitle"
                            android:layout_marginTop="10dp"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:textSize="15sp" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/homeAction"
                            style="@style/Car.Pill"
                            android:layout_width="match_parent" />

                        <Button
                            android:id="@+id/homeSecondary"
                            style="@style/Car.Pill"
                            android:layout_width="match_parent"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/car_pill_quiet" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============ music ============ -->
            <LinearLayout
                android:id="@+id/pageMusic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/car_music_padding"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/musicCover"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:background="@drawable/cover_background"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/car_music_padding"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/musicTitle"
                        style="@style/Car.Title"
                        android:maxLines="2"
                        android:textSize="@dimen/car_music_title" />

                    <TextView
                        android:id="@+id/musicArtist"
                        style="@style/Car.Subtitle"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_artist"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/musicAlbum"
                        style="@style/Car.Subtitle"
                        android:layout_marginTop="4dp"
                        android:textSize="18sp" />

                    <ProgressBar
                        android:id="@+id/musicProgress"
                        style="@style/Car.Progress"
                        android:layout_marginTop="28dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/musicElapsed"
                            style="@style/NowPlaying.Time"
                            android:layout_width="wrap_content"
                            android:layout_gravity="start" />

                        <TextView
                            android:id="@+id/musicRemaining"
                            style="@style/NowPlaying.Time"
                            android:layout_width="wrap_content"
                            android:layout_gravity="end" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/musicPrevious"
                            style="@style/Car.TransportButton.Large"
                            android:contentDescription="@string/car_previous"
                            android:src="@drawable/ic_previous" />

                        <ImageButton
                            android:id="@+id/musicPlay"
                            style="@style/Car.TransportButton.Large"
                            android:layout_width="@dimen/car_play_size"
                            android:layout_height="@dimen/car_play_size"
                            android:layout_marginStart="36dp"
                            android:layout_marginEnd="36dp"
                            android:background="@drawable/car_play_button"
                            android:contentDescription="@string/car_play_pause"
                            android:padding="22dp"
                            android:src="@drawable/ic_pause"
                            android:tint="@color/background" />

                        <ImageButton
                            android:id="@+id/musicNext"
                            style="@style/Car.TransportButton.Large"
                            android:contentDescription="@string/car_next"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============ mirror ============ -->
            <FrameLayout
                android:id="@+id/pageMirror"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <SurfaceView
                    android:id="@+id/surface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <!-- beside a portrait picture: the clock, what is playing, disconnect -->
                <LinearLayout
                    android:id="@+id/side"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/car_page_padding"
                    android:visibility="gone">

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:fontFeatureSettings="tnum"
                        android:format12Hour="h:mm"
                        android:format24Hour="H:mm"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/car_side_clock" />

                    <TextClock
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:format12Hour="EEEE, d MMMM"
                        android:format24Hour="EEEE, d MMMM"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:id="@+id/sideTrack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/car_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/sideCover"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/cover_small_background"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/sideTitle"
                                    style="@style/Car.Title"
                                    android:textSize="18sp" />

                                <TextView
                                    android:id="@+id/sideArtist"
                                    style="@style/Car.Subtitle"
                                    android:layout_marginTop="3dp"
                                    android:textSize="15sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/sidePrevious"
                                style="@style/Car.TransportButton"
                                android:contentDescription="@string/car_previous"
                                android:src="@drawable/ic_previous" />

                            <ImageButton
                                android:id="@+id/sidePlay"
                                style="@style/Car.TransportButton"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                android:contentDescription="@string/car_play_pause"
                                android:src="@drawable/ic_pause" />

                            <ImageButton
                                android:id="@+id/sideNext"
                                style="@style/Car.TransportButton"
                                android:contentDescription="@string/car_next"
                                android:src="@drawable/ic_next" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sideClient"
                        style="@style/Car.Subtitle"
                        android:layout_marginTop="20dp"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/sideDisconnect"
                        style="@style/Car.Pill"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:text="@string/car_stop_mirroring" />
                </LinearLayout>

                <!-- before the picture arrives, and for the PIN -->
                <LinearLayout
                    android:id="@+id/standby"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/black"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="69dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_airplay_glyph" />

                    <TextView
                        android:id="@+id/standbyText"
                        style="@style/Car.Title"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/pin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="0.35"
                        android:textColor="@color/text_primary"
                        android:textSize="80sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/overlay_background"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- ============ setup ============ -->
            <ScrollView
                android:id="@+id/pageSetup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/setupSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/car_music_padding">

                    <TextView
                        style="@style/Car.Title"
                        android:text="@string/car_setup_title"
                        android:textSize="30sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- over a full-screen landscape picture (maps): a touch brings these up without moving the picture -->
    <LinearLayout
        android:id="@+id/peek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="12dp"
        android:background="@drawable/car_peek"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/peekHome"
            style="@style/Car.DockButton"
            android:layout_marginTop="0dp"
            android:contentDescription="@string/car_home"
            android:src="@drawable/ic_car_home" />

        <ImageButton
            android:id="@+id/peekMusic"
            style="@style/Car.DockButton"
            android:contentDescription="@string/car_now_playing"
            android:src="@drawable/ic_music_note" />

        <ImageButton
            android:id="@+id/peekStop"
            style="@style/Car.DockButton"
            android:contentDescription="@string/car_stop_mirroring"
            android:src="@drawable/ic_car_close" />
    </LinearLayout>
</FrameLayout>
