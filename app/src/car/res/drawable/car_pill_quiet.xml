<?xml version="1.0" encoding="utf-8"?>
<!-- The second action of a card: an outline, so the first one leads. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/car_ripple">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/car_selected" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1.5dp" android:color="@color/car_button" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
